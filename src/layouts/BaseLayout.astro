---
import '../styles/global.css';
import { SIMULATORS, SITE_ORIGIN, withBase } from '../data/simulators';
import pricing from '../data/pricing-2026.json';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, canonicalPath, jsonLd = [] } = Astro.props;
const fullPath = withBase(canonicalPath);
const canonicalUrl = `${SITE_ORIGIN}${fullPath}`;
const currentPath = Astro.url.pathname;
const homeHref = withBase('/');
const aboutHref = withBase('/about/');
const sitemapHref = withBase('/sitemap.xml');
const faviconHref = withBase('/favicon.svg');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="theme-color" content="#F8FAFC" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={homeHref} class="brand-wordmark" aria-label="TokenScale Home">
          <svg class="brand-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="4" stroke="#1D4ED8" stroke-width="2" />
            <path d="M7 15.5V11.5M12 15.5V8.5M17 15.5V6.5" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span>TokenScale</span>
        </a>

        <nav class="site-nav" aria-label="Primary simulators">
          {SIMULATORS.map((sim) => (
            <a
              href={sim.href}
              class="nav-link"
              aria-current={currentPath === sim.href ? 'page' : undefined}
            >
              {sim.navLabel}
            </a>
          ))}
          <a
            href={aboutHref}
            class="nav-link"
            aria-current={currentPath === aboutHref ? 'page' : undefined}
          >
            Methodology
          </a>
        </nav>

        <div class="mobile-nav-wrap">
          <select
            class="mobile-nav-select"
            id="mobileNavSelect"
            aria-label="Switch simulator"
          >
            <option value={homeHref} selected={currentPath === homeHref}>All simulators</option>
            {SIMULATORS.map((sim) => (
              <option value={sim.href} selected={currentPath === sim.href}>
                {sim.navLabel}
              </option>
            ))}
            <option value={aboutHref} selected={currentPath === aboutHref}>Methodology</option>
          </select>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          TokenScale FinOps Bench &middot; Pricing dataset v{pricing.metadata.version} (updated {pricing.metadata.lastUpdated}) &middot; 100% client-side, zero telemetry.
        </div>
        <div class="footer-links">
          <a href={homeHref}>All simulators</a>
          <a href={aboutHref}>Methodology &amp; pricing sources</a>
          <a href={sitemapHref}>Sitemap</a>
        </div>
      </div>
    </footer>

    <script>
      const navSelect = document.getElementById('mobileNavSelect') as HTMLSelectElement | null;
      if (navSelect) {
        navSelect.addEventListener('change', () => {
          if (navSelect.value && navSelect.value !== window.location.pathname) {
            window.location.assign(navSelect.value);
          }
        });
      }
    </script>
  </body>
</html>
