---
import SimulatorLayout from '../../layouts/SimulatorLayout.astro';

const faqs = [
  {
    question: 'Why does TTS dominate cascaded Voice AI bills?',
    answer:
      'In a standard STT + LLM + TTS pipeline, streaming speech-to-text (Deepgram Nova-3) and efficient LLMs (GPT-5.4 mini or Gemini 3.8 Flash) cost under $0.01/min combined, while expressive neural TTS accounts for 70%–85% of the non-telephony bill.',
  },
  {
    question: 'How does Voice Activity Detection (VAD) silence trimming cut costs?',
    answer:
      'Typical phone conversations contain 25%–40% pauses, hold music, and turn-taking silence. Gating audio streams with client or gateway VAD (such as Silero VAD) prevents billing silent frames to STT or native Realtime audio-token endpoints.',
  },
  {
    question: 'When should teams choose Native Speech-to-Speech over a cascaded stack?',
    answer:
      'Native S2S models (OpenAI gpt-realtime-2.1, Gemini 3.8 Live API) preserve tone, laughter, and barge-in latency under 350ms without text-bottleneck loss. Cascaded stacks remain preferred when you need strict transcript auditing, custom pronunciation dictionaries, or lowest per-minute cost.',
  },
  {
    question: 'Does the telephony toggle include PSTN / SIP trunking?',
    answer:
      'Yes. Enabling telephony adds $0.014/min representing standard US inbound/outbound SIP trunking and media-stream transport (Twilio/Telnyx). WebRTC browser-to-agent sessions can toggle telephony off to zero out carrier charges.',
  },
];
---
<SimulatorLayout
  simId="voice-ai"
  pageTitle="Realtime Voice AI Pipeline Cost Simulator | TokenScale"
  h1="Realtime Voice AI Pipeline Cost Simulator"
  subtitle="Compare per-minute and monthly bills across cascaded STT + LLM + TTS pipelines and native Speech-to-Speech models with VAD silence trimming and telephony."
  metaDescription="Interactive Voice AI cost calculator comparing cascaded Deepgram + LLM + ElevenLabs/Cartesia pipelines vs OpenAI Realtime API and Gemini Live with VAD silence trimming."
  canonicalPath="/voice-ai-cost-calculator/"
  faqs={faqs}
>
  <Fragment slot="controls">
    <div class="preset-group" role="group" aria-label="Call volume presets">
      <button type="button" class="preset-btn" data-preset="mvp" aria-pressed="false">Startup MVP</button>
      <button type="button" class="preset-btn" data-preset="scaleup" aria-pressed="true">Scale-up SaaS</button>
      <button type="button" class="preset-btn" data-preset="enterprise" aria-pressed="false">Enterprise Batch</button>
    </div>

    <div class="control-field">
      <div class="control-row">
        <label class="control-label" for="callsNum">Daily calls</label>
        <input class="num-input" id="callsNum" type="number" min="50" max="50000" step="50" value="3500" />
      </div>
      <input class="range-input" id="callsRange" type="range" min="50" max="50000" step="50" value="3500" aria-label="Daily calls slider" />
    </div>

    <div class="control-field">
      <div class="control-row">
        <label class="control-label" for="durNum">Average call duration (min)</label>
        <input class="num-input" id="durNum" type="number" min="1" max="30" step="0.5" value="6" />
      </div>
      <input class="range-input" id="durRange" type="range" min="1" max="30" step="0.5" value="6" aria-label="Average call duration slider" />
    </div>

    <div class="control-field">
      <div class="control-row">
        <label class="control-label" for="vadNum">VAD silence trimming (%)</label>
        <input class="num-input" id="vadNum" type="number" min="0" max="60" step="5" value="30" />
      </div>
      <input class="range-input" id="vadRange" type="range" min="0" max="60" step="5" value="30" aria-label="VAD silence trimming slider" />
      <span class="control-hint">Portion of dead air gated out before AI billing</span>
    </div>

    <div class="toggle-row">
      <label class="control-label" for="telToggle">Include PSTN / SIP telephony ($0.014/min)</label>
      <input class="toggle-checkbox" id="telToggle" type="checkbox" checked />
    </div>
  </Fragment>

  <Fragment slot="results">
    <div class="kpi-strip">
      <div class="kpi-cell">
        <p class="kpi-label">Lowest cost / minute</p>
        <p class="kpi-value accent" id="kpiCheapestMin">$0.000</p>
        <p class="kpi-sub" id="kpiCheapestName">—</p>
      </div>
      <div class="kpi-cell">
        <p class="kpi-label">Lowest monthly bill</p>
        <p class="kpi-value" id="kpiCheapestMo">$0</p>
        <p class="kpi-sub" id="kpiMinutes">0 minutes / month</p>
      </div>
      <div class="kpi-cell">
        <p class="kpi-label">Max pipeline savings</p>
        <p class="kpi-value" id="kpiSavingsPct">0%</p>
        <p class="kpi-sub" id="kpiExpensiveRef">vs highest S2S stack</p>
      </div>
    </div>

    <div class="results-actions">
      <span class="control-hint">Assumes 50/50 user-to-agent active talk ratio on Speech-to-Speech audio tokens.</span>
      <div class="action-buttons">
        <button type="button" class="btn-secondary" id="copyUrlBtn">Copy scenario URL</button>
        <button type="button" class="btn-secondary" id="copyMdBtn">Copy Markdown</button>
        <button type="button" class="btn-secondary" id="copyEmbedBtn">Copy Embed</button>
        <button type="button" class="btn-primary" id="exportCsvBtn">Export CSV</button>
      </div>
    </div>

    <div class="chart-block">
      <h2 class="block-heading">Monthly voice pipeline bill breakdown (USD / month)</h2>
      <div class="chart-stage" id="voiceBarStage"></div>
    </div>

    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Voice AI pipeline</th>
            <th>Type</th>
            <th class="num">STT / In</th>
            <th class="num">LLM</th>
            <th class="num">TTS / Out</th>
            <th class="num">$/min</th>
            <th class="num">Monthly total</th>
          </tr>
        </thead>
        <tbody id="voiceTableBody"></tbody>
      </table>
    </div>
  </Fragment>

  <Fragment slot="formulas">
    <div class="formula-grid">
      <div>
        <h3>Cascaded vs Native S2S per-minute rates</h3>
        <div class="formula-box">
          ActiveFactor = 1 - (VAD_trim_pct / 100)<br />
          Cascaded_min = ActiveFactor * (P_stt + P_llm + P_tts) + P_tel<br />
          NativeS2S_min = ActiveFactor * (0.5 * P_audioIn + 0.5 * P_audioOut) + P_tel
        </div>
        <p>
          Telephony transport (<code>P_tel</code>) bills on full wall-clock call minutes regardless of VAD gating, whereas AI inference charges scale with active speech time.
        </p>
      </div>
      <div>
        <h3>Monthly call volume projection</h3>
        <div class="formula-box">
          MonthlyMinutes = DailyCalls * 30 * AvgCallMinutes<br />
          MonthlyBill = MonthlyMinutes * CostPerMinute
        </div>
        <p>
          For customer support and outbound qualification fleets exceeding 500k minutes/month, self-hosting Whisper + vLLM + Kokoro/Orpheus TTS on L40S GPUs can further reduce unit costs.
        </p>
      </div>
    </div>
  </Fragment>
</SimulatorLayout>

<script>
  import { calculateVoiceAiCost, VOICE_AI_PRESETS, type VoiceAiInput } from '../../lib/calculators/voice-ai';
  import { formatUsd, formatCompactUsd, formatCompactNumber, downloadCsv, buildMarkdownTable } from '../../lib/format';
  import { readStateFromUrl, writeStateToUrl, copyCurrentUrl, copyEmbedSnippet, copyTextWithFeedback, getCanonicalShareUrl, type ParamSpec } from '../../lib/url-state';
  import { renderStackedBarChart, CHART_COLORS } from '../../lib/svg-charts';

  const SPEC: ParamSpec = {
    dailyCalls: 'number',
    avgCallMinutes: 'number',
    silenceTrimPct: 'number',
    includeTelephony: 'boolean',
  };

  let state: VoiceAiInput = readStateFromUrl({ ...VOICE_AI_PRESETS.scaleup }, SPEC);

  const pairs: { key: keyof VoiceAiInput; numId: string; rangeId: string }[] = [
    { key: 'dailyCalls', numId: 'callsNum', rangeId: 'callsRange' },
    { key: 'avgCallMinutes', numId: 'durNum', rangeId: 'durRange' },
    { key: 'silenceTrimPct', numId: 'vadNum', rangeId: 'vadRange' },
  ];
  const telToggle = document.getElementById('telToggle') as HTMLInputElement;
  const presetBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.preset-btn'));

  function syncInputsFromState() {
    for (const p of pairs) {
      (document.getElementById(p.numId) as HTMLInputElement).value = String(state[p.key]);
      (document.getElementById(p.rangeId) as HTMLInputElement).value = String(state[p.key]);
    }
    telToggle.checked = state.includeTelephony;
  }

  let lastResult = calculateVoiceAiCost(state);

  function render() {
    lastResult = calculateVoiceAiCost(state);
    writeStateToUrl(state, SPEC);

    document.getElementById('kpiCheapestMin')!.textContent = `$${lastResult.cheapest.totalPerMin.toFixed(3)}/m`;
    document.getElementById('kpiCheapestName')!.textContent = lastResult.cheapest.name;

    document.getElementById('kpiCheapestMo')!.textContent = formatUsd(lastResult.cheapest.monthlyTotalUsd);
    document.getElementById('kpiMinutes')!.textContent =
      `${formatCompactNumber(lastResult.monthlyMinutes)} minutes / month`;

    document.getElementById('kpiSavingsPct')!.textContent = `${lastResult.savingsPct.toFixed(0)}%`;
    document.getElementById('kpiExpensiveRef')!.textContent =
      `vs ${lastResult.mostExpensive.name} (${formatUsd(lastResult.mostExpensive.monthlyTotalUsd)}/mo)`;

    const mins = lastResult.monthlyMinutes;
    document.getElementById('voiceBarStage')!.innerHTML = renderStackedBarChart(
      lastResult.pipelines.map((p) => ({
        label: p.name.length > 28 ? p.name.slice(0, 27) + '…' : p.name,
        totalDisplay: `${formatCompactUsd(p.monthlyTotalUsd)}/mo`,
        segments: [
          { label: 'STT / Audio In', value: p.sttPerMin * mins, color: CHART_COLORS[0] },
          { label: 'LLM', value: p.llmPerMin * mins, color: CHART_COLORS[3] },
          { label: 'TTS / Audio Out', value: p.ttsPerMin * mins, color: CHART_COLORS[1] },
          { label: 'Telephony', value: p.telephonyPerMin * mins, color: CHART_COLORS[2] },
        ],
      })),
      {
        title: 'Monthly Voice AI Cost Breakdown',
        legend: [
          { label: 'STT / In', color: CHART_COLORS[0] },
          { label: 'LLM', color: CHART_COLORS[3] },
          { label: 'TTS / Out', color: CHART_COLORS[1] },
          { label: 'Telephony', color: CHART_COLORS[2] },
        ],
      }
    );

    document.getElementById('voiceTableBody')!.innerHTML = lastResult.pipelines
      .map(
        (p, idx) => `<tr class="${idx === 0 ? 'row-highlight' : ''}">
          <td><strong>${p.name}</strong></td>
          <td>${p.architecture}</td>
          <td class="num">$${p.sttPerMin.toFixed(4)}</td>
          <td class="num">$${p.llmPerMin.toFixed(4)}</td>
          <td class="num">$${p.ttsPerMin.toFixed(4)}</td>
          <td class="num"><strong>$${p.totalPerMin.toFixed(3)}</strong></td>
          <td class="num"><strong>${formatUsd(p.monthlyTotalUsd)}</strong></td>
        </tr>`
      )
      .join('');
  }

  for (const p of pairs) {
    const numEl = document.getElementById(p.numId) as HTMLInputElement;
    const rangeEl = document.getElementById(p.rangeId) as HTMLInputElement;
    const onInput = (v: string) => {
      const n = Number(v);
      if (!Number.isFinite(n)) return;
      (state as any)[p.key] = n;
      numEl.value = v;
      rangeEl.value = v;
      presetBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      render();
    };
    numEl.addEventListener('input', () => onInput(numEl.value));
    rangeEl.addEventListener('input', () => onInput(rangeEl.value));
  }

  telToggle.addEventListener('change', () => {
    state.includeTelephony = telToggle.checked;
    render();
  });

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.preset!;
      if (VOICE_AI_PRESETS[key]) {
        state = { ...VOICE_AI_PRESETS[key] };
        presetBtns.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
        syncInputsFromState();
        render();
      }
    });
  });

  document.getElementById('copyUrlBtn')!.addEventListener('click', (e) => {
    copyCurrentUrl(e.currentTarget as HTMLButtonElement);
  });

  document.getElementById('copyMdBtn')!.addEventListener('click', (e) => {
    const md = buildMarkdownTable(
      `Realtime Voice AI Cost (${formatCompactNumber(state.dailyCalls)} calls/day × ${state.avgCallMinutes}m, ${state.silenceTrimPct}% VAD trim${state.includeTelephony ? ' + PSTN' : ''})`,
      ['Voice AI Pipeline', 'Type', '$/min', 'Monthly Total'],
      lastResult.pipelines.map((p) => [
        p.name,
        p.architecture,
        `$${p.totalPerMin.toFixed(3)}`,
        `**${formatUsd(p.monthlyTotalUsd)}**`,
      ]),
      getCanonicalShareUrl(false),
      [2, 3]
    );
    copyTextWithFeedback(e.currentTarget as HTMLButtonElement, md, 'Markdown copied');
  });

  document.getElementById('copyEmbedBtn')!.addEventListener('click', (e) => {
    copyEmbedSnippet(e.currentTarget as HTMLButtonElement, 'TokenScale Voice AI Cost Simulator');
  });

  document.getElementById('exportCsvBtn')!.addEventListener('click', () => {
    downloadCsv(
      'tokenscale-voice-ai-cost.csv',
      ['Pipeline', 'Architecture', 'STT/In per min USD', 'LLM per min USD', 'TTS/Out per min USD', 'Telephony per min USD', 'Total per min USD', 'Monthly Total USD'],
      lastResult.pipelines.map((p) => [
        p.name,
        p.architecture,
        p.sttPerMin.toFixed(4),
        p.llmPerMin.toFixed(4),
        p.ttsPerMin.toFixed(4),
        p.telephonyPerMin.toFixed(4),
        p.totalPerMin.toFixed(4),
        p.monthlyTotalUsd.toFixed(2),
      ])
    );
  });

  syncInputsFromState();
  render();
</script>
